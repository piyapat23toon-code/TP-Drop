  <!-- Application Logic -->
  <script>
    // --- State ---
    let currentTab = 'send';
    let myDeviceCode = generateRandomCode();
    let targetCode = '';
    let isConnected = false;
    let sentItems = [];
    let receivedItems = [];

    // Cross-tab real-time channel
    const channel = ('BroadcastChannel' in window) ? new BroadcastChannel('dropple_p2p_channel') : null;

    // --- Initialization ---
    window.addEventListener('DOMContentLoaded', () => {
      initPinInputs();
      renderMyCodeDisplay();
      drawDecorativeQR(myDeviceCode);
      initDragAndDrop();
      initClipboardPaste();
      setupBroadcastListener();
    });

    function generateRandomCode() {
      const chars = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';
      let code = '';
      for (let i = 0; i < 6; i++) {
        code += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return code;
    }

    // --- Tab Switching ---
    function switchTab(tab) {
      currentTab = tab;
      const tabSendBtn = document.getElementById('tabSendBtn');
      const tabReceiveBtn = document.getElementById('tabReceiveBtn');
      const viewSend = document.getElementById('viewSend');
      const viewReceive = document.getElementById('viewReceive');
      const receiveBadge = document.getElementById('receiveBadge');

      const activeClasses = ['bg-[#0d2e33]', 'text-[#2dd4bf]', 'border-[#134e56]/80', 'shadow-sm'];
      const inactiveClasses = ['text-slate-400', 'hover:text-slate-200', 'border-transparent'];

      if (tab === 'send') {
        tabSendBtn.classList.add(...activeClasses);
        tabSendBtn.classList.remove(...inactiveClasses);
        tabReceiveBtn.classList.remove(...activeClasses);
        tabReceiveBtn.classList.add(...inactiveClasses);

        viewSend.classList.remove('hidden');
        viewSend.classList.add('grid');
        viewReceive.classList.add('hidden');
        viewReceive.classList.remove('grid');
      } else {
        tabReceiveBtn.classList.add(...activeClasses);
        tabReceiveBtn.classList.remove(...inactiveClasses);
        tabSendBtn.classList.remove(...activeClasses);
        tabSendBtn.classList.add(...inactiveClasses);

        viewReceive.classList.remove('hidden');
        viewReceive.classList.add('grid');
        viewSend.classList.add('hidden');
        viewSend.classList.remove('grid');
        receiveBadge.classList.add('hidden');
      }
    }

    // --- 6-Digit PIN Inputs Logic ---
    function initPinInputs() {
      const inputs = document.querySelectorAll('.pin-input');
      inputs.forEach((input, idx) => {
        input.addEventListener('input', (e) => {
          const val = e.target.value.replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
          e.target.value = val;
          if (val && idx < inputs.length - 1) {
            inputs[idx + 1].focus();
          }
          checkPinCompletion();
        });

        input.addEventListener('keydown', (e) => {
          if (e.key === 'Backspace' && !e.target.value && idx > 0) {
            inputs[idx - 1].focus();
            inputs[idx - 1].value = '';
            checkPinCompletion();
          }
        });

        input.addEventListener('paste', (e) => {
          e.preventDefault();
          const pasted = (e.clipboardData || window.clipboardData)
            .getData('text')
            .replace(/[^a-zA-Z0-9]/g, '')
            .toUpperCase()
            .slice(0, 6);
          if (!pasted) return;
          pasted.split('').forEach((ch, i) => {
            if (inputs[i]) inputs[i].value = ch;
          });
          const focusIndex = Math.min(pasted.length, inputs.length - 1);
          inputs[focusIndex].focus();
          checkPinCompletion();
        });
      });
    }

    function checkPinCompletion() {
      const inputs = document.querySelectorAll('.pin-input');
      const code = Array.from(inputs).map(i => i.value.trim()).join('');
      if (code.length === 6) {
        connectToTarget(code);
      } else {
        setDisconnectedUI();
      }
    }

    function connectToTarget(code) {
      targetCode = code.toUpperCase();
      isConnected = true;

      // Update Header Dot to Green
      const statusDot = document.getElementById('statusDot');
      const statusText = document.getElementById('statusText');
      statusDot.classList.remove('bg-[#ef4444]');
      statusDot.classList.add('bg-[#10b981]', 'shadow-[0_0_8px_#10b981]');
      statusText.textContent = `เชื่อมต่อกับ #${targetCode} แล้ว`;
      statusText.classList.replace('text-slate-400', 'text-emerald-400');

      // Update Subtitle & Connected Banner
      document.getElementById('targetDeviceSubtitle').innerHTML =
        `กำลังส่งไปยังเครื่อง <span class="text-teal-400 font-semibold">#${targetCode}</span>`;
      
      const banner = document.getElementById('connectedBanner');
      banner.classList.remove('hidden');
      document.getElementById('connectedBannerText').textContent = `จับคู่กับเครื่อง #${targetCode} สำเร็จ พร้อมส่งไฟล์!`;

      // Highlight Step 2 badge
      const step2Badge = document.getElementById('step2Badge');
      const step2Title = document.getElementById('step2Title');
      step2Badge.className = 'w-6 h-6 rounded-full bg-[#0096c7] text-white text-xs font-bold flex items-center justify-center transition-colors';
      step2Title.className = 'text-[14px] font-semibold text-white transition-colors';

      // Notify peer if on another tab
      if (channel) {
        channel.postMessage({ type: 'PEER_CONNECTED', targetCode, senderName: getDeviceName() });
      }
    }

    function setDisconnectedUI() {
      isConnected = false;
      targetCode = '';
      const statusDot = document.getElementById('statusDot');
      const statusText = document.getElementById('statusText');
      statusDot.classList.add('bg-[#ef4444]');
      statusDot.classList.remove('bg-[#10b981]', 'shadow-[0_0_8px_#10b981]');
      statusText.textContent = 'ยังไม่ได้เชื่อมต่อ';
      statusText.classList.replace('text-emerald-400', 'text-slate-400');

      document.getElementById('targetDeviceSubtitle').textContent = 'ยังไม่ได้เลือกเครื่องปลายทาง';
      document.getElementById('connectedBanner').classList.add('hidden');

      const step2Badge = document.getElementById('step2Badge');
      const step2Title = document.getElementById('step2Title');
      step2Badge.className = 'w-6 h-6 rounded-full bg-[#262b36] text-slate-400 text-xs font-bold flex items-center justify-center transition-colors';
      step2Title.className = 'text-[14px] font-semibold text-slate-400 transition-colors';
    }

    function disconnectTarget() {
      const inputs = document.querySelectorAll('.pin-input');
      inputs.forEach(i => (i.value = ''));
      setDisconnectedUI();
      inputs[0].focus();
    }

    function fillDemoCode(customCode) {
      const codeToFill = customCode || myDeviceCode;
      const inputs = document.querySelectorAll('.pin-input');
      codeToFill.split('').forEach((ch, idx) => {
        if (inputs[idx]) inputs[idx].value = ch;
      });
      connectToTarget(codeToFill);
      showToast(`เชื่อมต่อกับรหัส #${codeToFill} เรียบร้อย ลองส่งไฟล์หรือข้อความได้เลย!`, 'info');
    }

    // --- File Selection, Drag & Drop, and Paste ---
    function triggerFileSelect() {
      document.getElementById('fileInput').click();
    }

    function handleFileSelect(e) {
      const files = Array.from(e.target.files || []);
      if (files.length > 0) {
        processOutgoingFiles(files);
        e.target.value = '';
      }
    }

    function initDragAndDrop() {
      let dragCounter = 0;
      const overlay = document.getElementById('globalDragOverlay');
      const dropZoneCard = document.getElementById('dropZoneCard');

      window.addEventListener('dragenter', (e) => {
        e.preventDefault();
        dragCounter++;
        overlay.classList.remove('opacity-0');
        overlay.classList.add('opacity-100');
        dropZoneCard.classList.add('drag-active');
      });

      window.addEventListener('dragleave', (e) => {
        e.preventDefault();
        dragCounter--;
        if (dragCounter <= 0) {
          dragCounter = 0;
          overlay.classList.add('opacity-0');
          overlay.classList.remove('opacity-100');
          dropZoneCard.classList.remove('drag-active');
        }
      });

      window.addEventListener('dragover', (e) => {
        e.preventDefault();
      });

      window.addEventListener('drop', (e) => {
        e.preventDefault();
        dragCounter = 0;
        overlay.classList.add('opacity-0');
        overlay.classList.remove('opacity-100');
        dropZoneCard.classList.remove('drag-active');

        const files = Array.from(e.dataTransfer?.files || []);
        if (files.length > 0) {
          if (currentTab !== 'send') switchTab('send');
          processOutgoingFiles(files);
        }
      });
    }

    function initClipboardPaste() {
      window.addEventListener('paste', (e) => {
        // Ignore if user is typing inside textarea or pin input
        const activeTag = document.activeElement?.tagName?.toLowerCase();
        if (activeTag === 'textarea' || activeTag === 'input') return;

        const items = Array.from(e.clipboardData?.items || []);
        const files = [];
        items.forEach(item => {
          if (item.kind === 'file') {
            const file = item.getAsFile();
            if (file) files.push(file);
          }
        });

        if (files.length > 0) {
          e.preventDefault();
          if (currentTab !== 'send') switchTab('send');
          processOutgoingFiles(files);
        }
      });
    }

    function ensureTargetBeforeSend() {
      if (isConnected) return true;
      const autoDemo = document.getElementById('autoDemoToggle')?.checked ?? true;
      if (autoDemo) {
        fillDemoCode(myDeviceCode);
        return true;
      } else {
        showToast('กรุณาใส่รหัส 6 หลักของเครื่องปลายทางก่อนส่ง', 'error');
        document.querySelector('.pin-input')?.focus();
        return false;
      }
    }

    function processOutgoingFiles(files) {
      if (!ensureTargetBeforeSend()) return;

      files.forEach(file => {
        const id = 'item_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7);
        const objectUrl = URL.createObjectURL(file);
        const newItem = {
          id,
          kind: 'file',
          name: file.name,
          size: file.size,
          mime: file.type || 'application/octet-stream',
          url: objectUrl,
          target: targetCode,
          progress: 0,
          status: 'sending',
          timestamp: new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' })
        };

        sentItems.unshift(newItem);
        renderSentItems();
        simulateFileTransfer(newItem, file);
      });
    }

    function simulateFileTransfer(item, rawFile) {
      let progress = 0;
      const step = Math.max(12, Math.floor(Math.random() * 28));
      const interval = setInterval(() => {
        progress += step;
        if (progress >= 100) {
          progress = 100;
          clearInterval(interval);
          item.progress = 100;
          item.status = 'completed';
          renderSentItems();
          showToast(`ส่งไฟล์ "${item.name}" สำเร็จ!`, 'success');

          // Deliver to Receive tab (same tab + BroadcastChannel for other tabs)
          deliverItemToReceiver({
            id: item.id,
            kind: 'file',
            name: item.name,
            size: item.size,
            mime: item.mime,
            url: item.url,
            targetCode: item.target,
            sender: getDeviceName(),
            timestamp: item.timestamp
          }, rawFile);
        } else {
          item.progress = progress;
          updateProgressBarDOM(item.id, progress);
        }
      }, 140);
    }

    function updateProgressBarDOM(id, progress) {
      const bar = document.getElementById(`prog_${id}`);
      const label = document.getElementById(`prog_label_${id}`);
      if (bar) bar.style.width = `${progress}%`;
      if (label) label.textContent = `${progress}%`;
    }

    // --- Sending Text Snippets ---
    function handleTextareaKey(e) {
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.preventDefault();
        sendTextSnippet();
      }
    }

    function sendTextSnippet() {
      const textarea = document.getElementById('textMessageInput');
      const text = textarea.value.trim();
      if (!text) {
        showToast('กรุณาพิมพ์ข้อความหรือวางลิงก์ก่อนกดส่ง', 'error');
        textarea.focus();
        return;
      }

      if (!ensureTargetBeforeSend()) return;

      const id = 'txt_' + Date.now();
      const newItem = {
        id,
        kind: 'text',
        text,
        target: targetCode,
        progress: 100,
        status: 'completed',
        timestamp: new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' })
      };

      sentItems.unshift(newItem);
      textarea.value = '';
      renderSentItems();
      showToast('ส่งข้อความไปยังเครื่องปลายทางแล้ว', 'success');

      deliverItemToReceiver({
        id: newItem.id,
        kind: 'text',
        text: newItem.text,
        targetCode: newItem.target,
        sender: getDeviceName(),
        timestamp: newItem.timestamp
      });
    }

    // --- Render Sent Items List ---
    function renderSentItems() {
      const emptyState = document.getElementById('sentEmptyState');
      const listEl = document.getElementById('sentItemsList');
      const countLabel = document.getElementById('sentCountLabel');
      const clearBtn = document.getElementById('clearSentBtn');

      if (sentItems.length === 0) {
        emptyState.classList.remove('hidden');
        listEl.classList.add('hidden');
        countLabel.textContent = 'ยังไม่มีรายการ';
        clearBtn.classList.add('hidden');
        return;
      }

      emptyState.classList.add('hidden');
      listEl.classList.remove('hidden');
      countLabel.textContent = `${sentItems.length} รายการ`;
      clearBtn.classList.remove('hidden');

      listEl.innerHTML = sentItems.map(item => {
        if (item.kind === 'text') {
          return `
            <div class="p-3.5 rounded-xl bg-[#0c0e12] border border-[#1a1f28] hover:border-[#252c38] transition-all">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-start gap-3 min-w-0">
                  <div class="w-9 h-9 rounded-lg bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                    </svg>
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-semibold text-slate-200">ข้อความ</span>
                      <span class="text-[11px] text-slate-500">→ #${item.target} · ${item.timestamp}</span>
                    </div>
                    <p class="text-xs text-slate-300 mt-1 break-all line-clamp-2 font-mono bg-[#11151c] px-2.5 py-1.5 rounded-lg border border-[#1a202c]">${escapeHtml(item.text)}</p>
                  </div>
                </div>
                <button onclick="copyTextToClipboard('${encodeURIComponent(item.text)}')" class="px-2.5 py-1.5 rounded-lg bg-[#151922] hover:bg-[#1e2430] text-slate-300 text-[11px] border border-[#242a36] shrink-0 transition-colors">
                  คัดลอก
                </button>
              </div>
            </div>
          `;
        }

        // File item
        const isDone = item.status === 'completed';
        return `
          <div class="p-3.5 rounded-xl bg-[#0c0e12] border border-[#1a1f28] hover:border-[#252c38] transition-all">
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-9 h-9 rounded-lg bg-teal-500/10 border border-teal-500/20 text-teal-400 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <div class="min-w-0">
                  <p class="text-xs font-semibold text-slate-200 truncate">${escapeHtml(item.name)}</p>
                  <p class="text-[11px] text-slate-500 mt-0.5">${formatBytes(item.size)} · ส่งไป #${item.target} · ${item.timestamp}</p>
                </div>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span id="prog_label_${item.id}" class="text-[11px] font-medium ${isDone ? 'text-teal-400' : 'text-cyan-400'}">
                  ${isDone ? 'ส่งแล้ว ✓' : item.progress + '%'}
                </span>
                ${item.url ? `
                  <a href="${item.url}" download="${escapeHtml(item.name)}" class="p-1.5 rounded-lg bg-[#151922] hover:bg-[#1e2430] text-slate-300 border border-[#242a36]" title="ดาวน์โหลดไฟล์">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V3"></path>
                    </svg>
                  </a>
                ` : ''}
              </div>
            </div>
            <!-- Progress bar -->
            <div class="w-full h-1.5 bg-[#161a22] rounded-full overflow-hidden mt-2.5">
              <div id="prog_${item.id}" class="h-full bg-gradient-to-r from-cyan-500 to-teal-400 transition-all duration-150" style="width: ${item.progress}%"></div>
            </div>
          </div>
        `;
      }).join('');
    }

    function clearSentItems() {
      sentItems = [];
      renderSentItems();
      showToast('ล้างประวัติรายการที่ส่งแล้ว', 'info');
    }

    // --- Receiver Side & Cross-Tab P2P ---
    function renderMyCodeDisplay() {
      const container = document.getElementById('myCodeDisplayGrid');
      container.innerHTML = myDeviceCode.split('').map(ch => `
        <div class="h-14 rounded-xl bg-[#0c0e12] border border-[#1d222b] flex items-center justify-center text-lg font-bold text-teal-400 select-all">
          ${ch}
        </div>
      `).join('');
    }

    function regenerateMyCode() {
      myDeviceCode = generateRandomCode();
      renderMyCodeDisplay();
      drawDecorativeQR(myDeviceCode);
      showToast(`เปลี่ยนรหัสเครื่องเป็น #${myDeviceCode} แล้ว`, 'info');
    }

    function copyMyCode() {
      copyTextToClipboard(encodeURIComponent(myDeviceCode), `คัดลอกรหัสเครื่อง #${myDeviceCode} แล้ว`);
    }

    function useMyCodeInSendTab() {
      switchTab('send');
      fillDemoCode(myDeviceCode);
    }

    function deliverItemToReceiver(payload, rawFile) {
      // 1. If target matches our own code (or single-tab demo), add to our Receive tab
      if (payload.targetCode === myDeviceCode) {
        onReceiveNewItem(payload);
      }
      // 2. Broadcast to any other open browser tabs
      if (channel) {
        const clonePayload = { ...payload };
        if (rawFile) {
          clonePayload.fileBlob = rawFile;
        }
        channel.postMessage({ type: 'NEW_TRANSFER', payload: clonePayload });
      }
    }

    function setupBroadcastListener() {
      if (!channel) return;
      channel.onmessage = (event) => {
        const data = event.data;
        if (!data) return;

        if (data.type === 'PEER_CONNECTED' && data.targetCode === myDeviceCode) {
          const statusDot = document.getElementById('statusDot');
          const statusText = document.getElementById('statusText');
          statusDot.classList.remove('bg-[#ef4444]');
          statusDot.classList.add('bg-[#10b981]', 'shadow-[0_0_8px_#10b981]');
          statusText.textContent = `เชื่อมต่อกับ ${data.senderName} แล้ว`;
          statusText.classList.replace('text-slate-400', 'text-emerald-400');
          showToast(`เครื่อง "${data.senderName}" เชื่อมต่อเข้ามาแล้ว!`, 'info');
        }

        if (data.type === 'NEW_TRANSFER') {
          const p = data.payload;
          if (p.targetCode === myDeviceCode) {
            if (p.fileBlob) {
              p.url = URL.createObjectURL(p.fileBlob);
            }
            onReceiveNewItem(p);
          }
        }
      };
    }

    function onReceiveNewItem(item) {
      // Prevent duplicate IDs
      if (receivedItems.some(r => r.id === item.id)) return;
      receivedItems.unshift(item);
      renderReceivedItems();

      // Update badge if user is currently on Send tab
      if (currentTab !== 'receive') {
        const badge = document.getElementById('receiveBadge');
        badge.textContent = receivedItems.length;
        badge.classList.remove('hidden');
      } else {
        showToast(item.kind === 'text' ? 'ได้รับข้อความใหม่!' : `ได้รับไฟล์ "${item.name}"`, 'success');
      }

      // Auto-copy text if setting enabled
      const autoCopy = document.getElementById('autoCopyToggle')?.checked ?? true;
      if (item.kind === 'text' && autoCopy) {
        copyRawString(item.text);
      }
    }

    function simulateIncomingItem() {
      const samples = [
        { kind: 'file', name: 'Dropple_Design_Mockup.png', size: 1458200, mime: 'image/png' },
        { kind: 'text', text: 'https://dropple.app/share/room-8942 — ลิงก์เอกสารสรุปการประชุมวันนี้ครับ' },
        { kind: 'file', name: 'Project_Report_2026.pdf', size: 3204900, mime: 'application/pdf' }
      ];
      const pick = samples[Math.floor(Math.random() * samples.length)];
      const blob = new Blob([`Sample content from Dropple (${new Date().toISOString()})`], { type: 'text/plain' });

      onReceiveNewItem({
        id: 'sim_' + Date.now(),
        kind: pick.kind,
        name: pick.name,
        size: pick.size,
        text: pick.text,
        url: URL.createObjectURL(blob),
        sender: 'iPhone-16-Pro',
        timestamp: new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' })
      });
    }

    function renderReceivedItems() {
      const emptyState = document.getElementById('receivedEmptyState');
      const listEl = document.getElementById('receivedItemsList');
      const countLabel = document.getElementById('receivedCountLabel');

      if (receivedItems.length === 0) {
        emptyState.classList.remove('hidden');
        listEl.classList.add('hidden');
        countLabel.textContent = 'ยังไม่มีรายการ';
        return;
      }

      emptyState.classList.add('hidden');
      listEl.classList.remove('hidden');
      countLabel.textContent = `${receivedItems.length} รายการ`;

      listEl.innerHTML = receivedItems.map(item => {
        if (item.kind === 'text') {
          return `
            <div class="p-3.5 rounded-xl bg-[#0c0e12] border border-[#1a1f28] hover:border-teal-500/30 transition-all">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-start gap-3 min-w-0">
                  <div class="w-9 h-9 rounded-lg bg-teal-500/10 border border-teal-500/20 text-teal-400 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                    </svg>
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-semibold text-teal-300">ข้อความจาก ${escapeHtml(item.sender || 'เครื่องต้นทาง')}</span>
                      <span class="text-[11px] text-slate-500">· ${item.timestamp}</span>
                    </div>
                    <p class="text-xs text-slate-200 mt-1.5 break-all font-mono bg-[#11151c] px-2.5 py-2 rounded-lg border border-[#1a202c]">${escapeHtml(item.text)}</p>
                  </div>
                </div>
                <button onclick="copyTextToClipboard('${encodeURIComponent(item.text)}')" class="px-3 py-1.5 rounded-lg bg-[#0d2e33] hover:bg-[#13434a] text-[#2dd4bf] text-xs font-medium border border-[#134e56] shrink-0 transition-colors">
                  คัดลอก
                </button>
              </div>
            </div>
          `;
        }

        return `
          <div class="p-3.5 rounded-xl bg-[#0c0e12] border border-[#1a1f28] hover:border-teal-500/30 transition-all flex items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-9 h-9 rounded-lg bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V3"></path>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-semibold text-white truncate">${escapeHtml(item.name)}</p>
                <p class="text-[11px] text-slate-500 mt-0.5">${formatBytes(item.size)} · จาก ${escapeHtml(item.sender || 'เครื่องต้นทาง')} · ${item.timestamp}</p>
              </div>
            </div>
            <a href="${item.url || '#'}" download="${escapeHtml(item.name)}" class="px-3 py-1.5 rounded-lg bg-[#0d2e33] hover:bg-[#13434a] text-[#2dd4bf] border border-[#134e56] text-xs font-medium shrink-0 transition-colors flex items-center gap-1.5">
              <span>บันทึก</span>
            </a>
          </div>
        `;
      }).join('');
    }

    // --- Decorative Deterministic QR Code Canvas ---
    function drawDecorativeQR(codeStr) {
      const canvas = document.getElementById('qrCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const size = 21;
      const cell = canvas.width / size;

      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.fillStyle = '#090b0e';

      const drawFinder = (r, c) => {
        ctx.fillRect(c * cell, r * cell, 7 * cell, 7 * cell);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect((c + 1) * cell, (r + 1) * cell, 5 * cell, 5 * cell);
        ctx.fillStyle = '#090b0e';
        ctx.fillRect((c + 2) * cell, (r + 2) * cell, 3 * cell, 3 * cell);
      };

      drawFinder(0, 0);
      drawFinder(0, size - 7);
      drawFinder(size - 7, 0);

      let seed = 0;
      for (let i = 0; i < codeStr.length; i++) {
        seed = (seed * 31 + codeStr.charCodeAt(i)) & 0xffffffff;
      }

      for (let r = 0; r < size; r++) {
        for (let c = 0; c < size; c++) {
          const inTopLeft = r < 8 && c < 8;
          const inTopRight = r < 8 && c >= size - 8;
          const inBottomLeft = r >= size - 8 && c < 8;
          if (inTopLeft || inTopRight || inBottomLeft) continue;

          seed = (seed * 1664525 + 1013904223) & 0xffffffff;
          if ((seed >>> 28) % 2 === 0) {
            ctx.fillRect(c * cell, r * cell, Math.ceil(cell), Math.ceil(cell));
          }
        }
      }
    }

    // --- Utilities (Clipboard, Formatting, Modals, Toasts) ---
    function copyRawString(str) {
      const ta = document.createElement('textarea');
      ta.value = str;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand('copy');
      } catch (err) {}
      document.body.removeChild(ta);
    }

    function copyTextToClipboard(encodedStr, customMsg) {
      const str = decodeURIComponent(encodedStr);
      copyRawString(str);
      showToast(customMsg || 'คัดลอกลงคลิปบอร์ดแล้ว!', 'success');
    }

    function formatBytes(bytes) {
      if (!bytes || bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    function escapeHtml(str) {
      if (!str) return '';
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function getDeviceName() {
      return document.getElementById('deviceNameInput')?.value?.trim() || 'Dropple-PC';
    }

    function openModal(id) {
      const el = document.getElementById(id);
      if (el) {
        el.classList.remove('hidden');
        el.classList.add('flex');
      }
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) {
        el.classList.add('hidden');
        el.classList.remove('flex');
      }
    }

    function saveSettings() {
      closeModal('settingsModal');
      showToast('บันทึกการตั้งค่าเรียบร้อยแล้ว', 'success');
    }

    function resetOrDemoToast() {
      showToast('Dropple — ลากไฟล์มาวางตรงไหนของหน้าเพื่อส่งได้ทันที', 'info');
    }

    function showToast(message, type = 'info') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      
      let borderColor = 'border-[#1d222b]';
      let iconColor = 'text-cyan-400';
      if (type === 'success') {
        borderColor = 'border-teal-500/40';
        iconColor = 'text-teal-400';
      } else if (type === 'error') {
        borderColor = 'border-rose-500/40';
        iconColor = 'text-rose-400';
      }

      toast.className = `pointer-events-auto flex items-center gap-2.5 px-4 py-3 rounded-xl bg-[#12161f]/95 backdrop-blur border ${borderColor} shadow-xl text-xs text-slate-200 transition-all duration-300 translate-y-2 opacity-0`;
      toast.innerHTML = `
        <span class="w-2 h-2 rounded-full ${iconColor.replace('text-', 'bg-')}"></span>
        <span>${escapeHtml(message)}</span>
      `;

      container.appendChild(toast);
      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }
  </script>
