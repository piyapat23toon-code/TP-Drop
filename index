<!DOCTYPE html>
<html lang="th" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TP Drop</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Prompt / Noto Sans Thai & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Thai:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Inter"', '"Noto Sans Thai"', 'sans-serif'],
          },
          colors: {
            bgMain: '#090b0e',
            cardBg: '#101318',
            cardBorder: '#1d222b',
            inputBg: '#0c0e12',
            tealActiveBg: '#0d2e33',
            tealActiveBorder: '#134e56',
            tealAccent: '#2dd4bf',
            cyanBadge: '#00a8cc',
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #090b0e;
      color: #e2e8f0;
      font-family: 'Inter', 'Noto Sans Thai', sans-serif;
      overflow-x: hidden;
    }

    /* Custom subtle scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #090b0e;
    }
    ::-webkit-scrollbar-thumb {
      background: #1e2430;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #2e3748;
    }

    /* Code input styling */
    .pin-input {
      transition: all 0.18s ease;
    }
    .pin-input:focus {
      border-color: #00b4d8;
      box-shadow: 0 0 0 2px rgba(0, 180, 216, 0.2);
      outline: none;
    }

    /* Subtle float animation for the cute droplet mascot */
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-5px); }
    }
    .mascot-float {
      animation: floatSlow 3.5s ease-in-out infinite;
    }

    /* Drag overlay effect */
    .drag-active {
      border-color: #2dd4bf !important;
      background-color: rgba(13, 46, 51, 0.25) !important;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-teal-500/30 selection:text-teal-200">

  <!-- Full-window Drag Overlay -->
  <div id="globalDragOverlay" class="fixed inset-0 z-50 pointer-events-none opacity-0 transition-opacity duration-200 bg-black/70 backdrop-blur-sm flex items-center justify-center p-6">
    <div class="border-2 border-dashed border-teal-400 bg-[#0d2e33]/60 rounded-3xl p-12 text-center max-w-md w-full shadow-2xl">
      <div class="w-20 h-20 mx-auto mb-4 flex items-center justify-center">
        <!-- Cute Droplet SVG -->
        <svg viewBox="0 0 100 120" class="w-16 h-20">
          <path d="M50 8 C50 8 14 56 14 82 C14 102 30 114 50 114 C70 114 86 102 86 82 C86 56 50 8 50 8 Z" fill="#177e89" />
          <path d="M50 8 C50 8 23 54 23 80 C23 97 35 108 50 108 C65 108 77 97 77 80 C77 54 50 8 50 8 Z" fill="#1dbab4" />
          <ellipse cx="34" cy="64" rx="5" ry="9" transform="rotate(20 34 64)" fill="#5eead4" opacity="0.6"/>
          <circle cx="38" cy="82" r="4.2" fill="#0f172a"/>
          <circle cx="62" cy="82" r="4.2" fill="#0f172a"/>
          <circle cx="36.5" cy="80.5" r="1.5" fill="#ffffff"/>
          <circle cx="60.5" cy="80.5" r="1.5" fill="#ffffff"/>
          <ellipse cx="31" cy="88" rx="4" ry="2.2" fill="#f43f5e" opacity="0.55"/>
          <ellipse cx="69" cy="88" rx="4" ry="2.2" fill="#f43f5e" opacity="0.55"/>
          <path d="M44 89 Q50 95 56 89" stroke="#0f172a" stroke-width="3" stroke-linecap="round" fill="none"/>
        </svg>
      </div>
      <h3 class="text-xl font-semibold text-teal-300 mb-1">ปล่อยไฟล์เพื่อส่งทันที</h3>
      <p class="text-sm text-slate-300">วางไฟล์ตรงไหนของหน้านี้ก็ได้</p>
    </div>
  </div>

  <!-- Main Container -->
  <div class="max-w-[1040px] w-full mx-auto px-4 sm:px-6 pt-5 pb-16 flex-1">
    
    <!-- Top Header -->
    <header class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3.5">
        <!-- App Logo Icon -->
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-b from-[#25c4e8] to-[#0096c7] flex items-center justify-center shadow-lg shadow-cyan-500/15 select-none cursor-pointer" onclick="resetOrDemoToast()">
          <svg viewBox="0 0 36 36" class="w-7 h-7" fill="none">
            <!-- Water droplet -->
            <path d="M18 5C18 5 9 15.8 9 21.5C9 26.2 13.0294 29.5 18 29.5C22.9706 29.5 27 26.2 27 21.5C27 15.8 18 5 18 5Z" fill="white"/>
            <!-- Subtle puddle ring underneath -->
            <ellipse cx="18" cy="31.5" rx="9" ry="1.8" fill="white" fill-opacity="0.75"/>
          </svg>
        </div>
        <div>
          <h1 class="text-[19px] font-bold tracking-tight text-white leading-tight">Dropple</h1>
          <div class="flex items-center gap-2 mt-0.5">
            <!-- Connection Status Dot -->
            <span id="statusDot" class="w-2.5 h-2.5 rounded-full bg-[#ef4444] inline-block transition-colors duration-300" title="สถานะการเชื่อมต่อ"></span>
            <span id="statusText" class="text-[11px] text-slate-400 hidden sm:inline">ยังไม่ได้เชื่อมต่อ</span>
          </div>
        </div>
      </div>

      <!-- Right Action Buttons -->
      <div class="flex items-center gap-2.5">
        <!-- Help Button -->
        <button onclick="openModal('helpModal')" class="w-10 h-10 rounded-xl bg-[#11141b] border border-[#1e232d] hover:border-slate-700 hover:bg-[#171b24] flex items-center justify-center text-slate-400 hover:text-slate-200 transition-all" title="วิธีใช้งาน">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9"></circle>
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3m.08 4h.01"></path>
          </svg>
        </button>

        <!-- Coffee / Support Button -->
        <button onclick="openModal('coffeeModal')" class="w-10 h-10 rounded-xl bg-[#11141b] border border-[#1e232d] hover:border-amber-500/40 hover:bg-[#171b24] flex items-center justify-center text-[#f59e0b] transition-all" title="สนับสนุนผู้พัฒนา">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 8h1a4 4 0 010 8h-1M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8zm4-6v2m4-2v2m4-2v2"></path>
          </svg>
        </button>

        <!-- Settings Button -->
        <button onclick="openModal('settingsModal')" class="w-10 h-10 rounded-xl bg-[#11141b] border border-[#1e232d] hover:border-slate-700 hover:bg-[#171b24] flex items-center justify-center text-slate-400 hover:text-slate-200 transition-all" title="ตั้งค่า">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </button>
      </div>
    </header>

    <!-- Mode Switcher Tabs (รับไฟล์ / ส่งไฟล์) -->
    <div class="inline-flex p-1.5 rounded-2xl bg-[#101318] border border-[#1d222b] mb-6 w-full sm:w-[360px]">
      <!-- Receive Tab -->
      <button id="tabReceiveBtn" onclick="switchTab('receive')" class="flex-1 flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-sm font-medium transition-all text-slate-400 hover:text-slate-200 border border-transparent">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V3"></path>
        </svg>
        <span>รับไฟล์</span>
        <span id="receiveBadge" class="hidden ml-1 px-1.5 py-0.2 text-[11px] bg-teal-500/20 text-teal-300 rounded-full">0</span>
      </button>

      <!-- Send Tab (Active by Default as in Screenshot) -->
      <button id="tabSendBtn" onclick="switchTab('send')" class="flex-1 flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-sm font-medium transition-all bg-[#0d2e33] text-[#2dd4bf] border border-[#134e56]/80 shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M16 8l-4-4m0 0L8 8m4-4v12"></path>
        </svg>
        <span>ส่งไฟล์</span>
      </button>
    </div>

    <!-- ========================================== -->
    <!-- VIEW 1: SEND FILES (ส่งไฟล์ - Default)     -->
    <!-- ========================================== -->
    <div id="viewSend" class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
      
      <!-- Left Column: Sent Items Card (7 cols on lg) -->
      <div class="lg:col-span-7 bg-[#101318] border border-[#1d222b] rounded-2xl overflow-hidden flex flex-col min-h-[540px]">
        <!-- Card Header -->
        <div class="px-5 py-4 border-b border-[#1a1f28] flex items-center justify-between">
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-[#0d2e33] border border-[#134e56]/60 flex items-center justify-center text-[#2dd4bf]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18 M4 4h16"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-[15px] font-semibold text-white leading-snug">รายการที่ส่ง</h2>
              <p id="targetDeviceSubtitle" class="text-xs text-slate-400 mt-0.5">ยังไม่ได้เลือกเครื่องปลายทาง</p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <span id="sentCountLabel" class="text-xs text-slate-400">ยังไม่มีรายการ</span>
            <button id="clearSentBtn" onclick="clearSentItems()" class="hidden text-xs text-slate-400 hover:text-rose-400 transition-colors">ล้างทั้งหมด</button>
          </div>
        </div>

        <!-- Card Body: Empty State or Sent Items List -->
        <div class="flex-1 flex flex-col p-5">
          <!-- Empty State -->
          <div id="sentEmptyState" class="my-auto py-16 text-center max-w-md mx-auto">
            <p class="text-[13.5px] text-slate-400 leading-relaxed mb-1.5">
              ไฟล์และข้อความที่ส่งจะขึ้นที่นี่ พร้อมความคืบหน้าของแต่ละรายการ
            </p>
            <p class="text-[13px] text-slate-500 leading-relaxed">
              ลากไฟล์มาวางตรงไหนของหน้าก็ได้ หรือพิมพ์ข้อความแล้วกดส่ง
            </p>
          </div>

          <!-- Sent Items List Container -->
          <div id="sentItemsList" class="hidden space-y-3 overflow-y-auto max-h-[440px] pr-1"></div>
        </div>
      </div>

      <!-- Right Column: Step 1 & Step 2 (5 cols on lg) -->
      <div class="lg:col-span-5 flex flex-col gap-5">
        
        <!-- Step 1 Card: เลือกเครื่องที่จะส่งไป -->
        <div class="bg-[#101318] border border-[#1d222b] rounded-2xl p-5">
          <div class="flex items-center justify-between mb-1.5">
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-full bg-[#0096c7] text-white text-xs font-bold flex items-center justify-center shadow-sm">1</span>
              <h3 class="text-[15px] font-semibold text-white">เลือกเครื่องที่จะส่งไป</h3>
            </div>
            <!-- Quick Demo Fill Button for smooth testing -->
            <button onclick="fillDemoCode()" class="text-[11px] px-2.5 py-1 rounded-lg bg-[#161b24] hover:bg-[#1e2633] text-cyan-400 border border-cyan-500/20 transition-all flex items-center gap-1" title="คลิกเพื่อจำลองรหัสเครื่องปลายทางและทดสอบส่งได้ทันที">
              <span>⚡ ทดลองรหัส</span>
            </button>
          </div>
          
          <p class="text-xs text-slate-400 mb-4">
            ใส่รหัส 6 ตัวที่แสดงบนเครื่องนั้น หรือสแกน QR ด้วยกล้องมือถือ
          </p>

          <!-- 6-Digit PIN Boxes -->
          <div class="grid grid-cols-6 gap-2 sm:gap-2.5" id="pinInputsContainer">
            <input type="text" maxlength="1" data-index="0" class="pin-input w-full h-14 rounded-xl bg-[#0c0e12] border border-[#1d222b] text-center text-lg font-semibold text-white uppercase" autocomplete="off" inputmode="text" />
            <input type="text" maxlength="1" data-index="1" class="pin-input w-full h-14 rounded-xl bg-[#0c0e12] border border-[#1d222b] text-center text-lg font-semibold text-white uppercase" autocomplete="off" inputmode="text" />
            <input type="text" maxlength="1" data-index="2" class="pin-input w-full h-14 rounded-xl bg-[#0c0e12] border border-[#1d222b] text-center text-lg font-semibold text-white uppercase" autocomplete="off" inputmode="text" />
            <input type="text" maxlength="1" data-index="3" class="pin-input w-full h-14 rounded-xl bg-[#0c0e12] border border-[#1d222b] text-center text-lg font-semibold text-white uppercase" autocomplete="off" inputmode="text" />
            <input type="text" maxlength="1" data-index="4" class="pin-input w-full h-14 rounded-xl bg-[#0c0e12] border border-[#1d222b] text-center text-lg font-semibold text-white uppercase" autocomplete="off" inputmode="text" />
            <input type="text" maxlength="1" data-index="5" class="pin-input w-full h-14 rounded-xl bg-[#0c0e12] border border-[#1d222b] text-center text-lg font-semibold text-white uppercase" autocomplete="off" inputmode="text" />
          </div>

          <!-- Connected Banner (Hidden until 6 digits entered) -->
          <div id="connectedBanner" class="hidden mt-3.5 px-3.5 py-2.5 rounded-xl bg-teal-500/10 border border-teal-500/25 flex items-center justify-between">
            <div class="flex items-center gap-2 text-xs text-teal-300">
              <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
              <span id="connectedBannerText">เชื่อมต่อกับเครื่องปลายทางแล้ว พร้อมส่ง!</span>
            </div>
            <button onclick="disconnectTarget()" class="text-[11px] text-slate-400 hover:text-white underline">เปลี่ยนเครื่อง</button>
          </div>
        </div>

        <!-- Step 2 Section Header (Outside Card, matching screenshot) -->
        <div class="flex items-center gap-2.5 px-1 -mb-1.5">
          <span id="step2Badge" class="w-6 h-6 rounded-full bg-[#262b36] text-slate-400 text-xs font-bold flex items-center justify-center transition-colors">2</span>
          <h3 id="step2Title" class="text-[14px] font-semibold text-slate-400 transition-colors">เลือกไฟล์หรือพิมพ์ข้อความ</h3>
        </div>

        <!-- Dropzone Card -->
        <div id="dropZoneCard" onclick="triggerFileSelect()" class="bg-[#101318] border border-[#1d222b] hover:border-[#2a3241] rounded-2xl p-7 text-center cursor-pointer transition-all group select-none">
          <input type="file" id="fileInput" multiple class="hidden" onchange="handleFileSelect(event)" />
          
          <!-- Cute Smiling Water Droplet SVG Mascot -->
          <div class="w-20 h-24 mx-auto mb-3 flex items-center justify-center mascot-float">
            <svg viewBox="0 0 100 120" class="w-16 h-20 drop-shadow-md">
              <!-- Outer darker teal layer -->
              <path d="M50 10 C50 10 15 57 15 83 C15 103 31 114 50 114 C69 114 85 103 85 83 C85 57 50 10 50 10 Z" fill="#135d66" />
              <!-- Inner lighter teal body -->
              <path d="M50 14 C50 14 20 57 20 82 C20 100 34 110 50 110 C66 110 80 100 80 82 C80 57 50 14 50 14 Z" fill="#1b7f8c" />
              <!-- Water shine highlight -->
              <ellipse cx="34" cy="64" rx="5.5" ry="10.5" transform="rotate(21 34 64)" fill="#4ea8b4" opacity="0.55"/>
              <!-- Cute Eyes -->
              <circle cx="38" cy="83" r="4.3" fill="#090d14"/>
              <circle cx="62" cy="83" r="4.3" fill="#090d14"/>
              <!-- Eye sparkles -->
              <circle cx="36.5" cy="81.3" r="1.5" fill="#cbd5e1"/>
              <circle cx="60.5" cy="81.3" r="1.5" fill="#cbd5e1"/>
              <!-- Rosy Cheeks -->
              <ellipse cx="31" cy="89" rx="4.2" ry="2.3" fill="#9f4258" opacity="0.65"/>
              <ellipse cx="69" cy="89" rx="4.2" ry="2.3" fill="#9f4258" opacity="0.65"/>
              <!-- Smile -->
              <path d="M45 89.5 Q50 95 55 89.5" stroke="#090d14" stroke-width="2.8" stroke-linecap="round" fill="none"/>
            </svg>
          </div>

          <p class="text-[14.5px] font-semibold text-slate-300 group-hover:text-white transition-colors mb-1">
            ลากไฟล์มาวางที่นี่
          </p>
          <p class="text-xs text-slate-500">
            หรือคลิกเพื่อเลือก · กด Ctrl/⌘ +V วางไฟล์ที่ก๊อปไว้ก็ได้
          </p>
        </div>

        <!-- Text Snippet Input Card -->
        <div class="bg-[#101318] border border-[#1d222b] rounded-2xl p-3.5">
          <div class="relative">
            <textarea
              id="textMessageInput"
              rows="3"
              placeholder="พิมพ์หรือวางข้อความ ลิงก์ โค้ด... ปลายทางคัดลอกให้เลย"
              class="w-full rounded-xl bg-[#0c0e12] border border-[#1a1f28] focus:border-[#00a8cc] focus:outline-none p-3.5 text-sm text-slate-200 placeholder-slate-500 resize-none transition-colors"
              onkeydown="handleTextareaKey(event)"
            ></textarea>
          </div>
          <div class="flex items-center justify-between mt-2.5 px-1">
            <span class="text-[11px] text-slate-500">กด <kbd class="px-1.5 py-0.5 rounded bg-[#181c24] text-slate-400 border border-[#252b37]">Ctrl + Enter</kbd> เพื่อส่งทันที</span>
            <button
              onclick="sendTextSnippet()"
              class="px-4 py-1.5 rounded-xl bg-[#0d2e33] hover:bg-[#123e45] text-[#2dd4bf] border border-[#134e56] text-xs font-medium transition-all flex items-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
              </svg>
              <span>ส่งข้อความ</span>
            </button>
          </div>
        </div>

      </div>
    </div>

    <!-- ========================================== -->
    <!-- VIEW 2: RECEIVE FILES (รับไฟล์)             -->
    <!-- ========================================== -->
    <div id="viewReceive" class="hidden grid-cols-1 lg:grid-cols-12 gap-5 items-start">
      
      <!-- Left Column: Received Items Card (7 cols on lg) -->
      <div class="lg:col-span-7 bg-[#101318] border border-[#1d222b] rounded-2xl overflow-hidden flex flex-col min-h-[540px]">
        <div class="px-5 py-4 border-b border-[#1a1f28] flex items-center justify-between">
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-[#0d2e33] border border-[#134e56]/60 flex items-center justify-center text-[#2dd4bf]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V3"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-[15px] font-semibold text-white leading-snug">รายการที่รับ</h2>
              <p class="text-xs text-slate-400 mt-0.5">พร้อมรับไฟล์และข้อความจากเครื่องต้นทาง</p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <span id="receivedCountLabel" class="text-xs text-slate-400">ยังไม่มีรายการ</span>
            <button onclick="simulateIncomingItem()" class="text-[11px] px-2.5 py-1 rounded-lg bg-[#161b24] hover:bg-[#1e2633] text-teal-400 border border-teal-500/20 transition-all">
              + จำลองรับไฟล์
            </button>
          </div>
        </div>

        <!-- Received Items Body -->
